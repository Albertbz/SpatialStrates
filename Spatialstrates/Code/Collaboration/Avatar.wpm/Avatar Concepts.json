{
    "concepts": {
        "AvatarManager": {
            "schema": {
                "enabled": "boolean"
            }
        },
        "Avatar": {
            "schema": {
                "type": {
                    "string":{
                        "default": "camera",
                        "enum": [ "camera", "controllerLeft", "controllerRight", "handLeft", "handRight", "cursor" ]
                    }
                },
                "avatarXRPlatform": "string",
                "inputSourceProfile": "string",
                "client": "string",
                "user": "User",
                "pairedAvatar": "Avatar",
                "mergeRole": {
                    "string": {
                        "default": "none",
                        "enum": [ "none", "source", "target" ]
                    }
                },
                "mergeState": {
                    "string": {
                        "default": "unpaired",
                        "enum": [ "unpaired", "paired", "merging", "merged" ]
                    }
                },
                "deviceType": {
                    "string": {
                    "default": "browser",
                    "enum": [ "browser", "vr", "ar" ]
                    }
                },
                "deviceClass": {
                    "string": {
                    "default": "laptop",
                    "enum": [ "laptop", "xr-browser" ]
                    }
                },
                "clientAudioStream": { "array": {
                    "items": "AudioStream",
                    "derive": {
                        "concepts": [ "AudioStream" ],
                        "properties": [ "client" ],
                        "transform": [
                            { "get": { "property": "client", "as": "client" }},
                            { "select": {
                                "concept": "AudioStream",
                                "where": { "property": "client", "equals": "$client" },
                                "keepContext": true
                            }}
                        ]
                    }
                }},
                "userName": "string",
                "isMine": "boolean",
                "position": { "array": {
                    "items": "number",
                    "default": [ 0, 0, 0 ]
                }},
                "rotation": { "array": {
                    "items": "number",
                    "default": [ 0, 0, 0 ]
                }},
                "remoteControlled": "boolean",
                "remoteControllingClient": "string",
                "space": "Space",
                "view": "string",
                "otherSpace": "Space",
                "otherSpaceRelativePosition": { "array": {
                    "items": "number",
                    "default": [ 0, 0, 0 ]
                }},
                "otherSpaceRelativeRotation": { "array": {
                    "items": "number",
                    "default": [ 0, 0, 0 ]
                }},
                "active": "boolean"
            },
            "defaultMappings": [ "signaling", "memory", "cauldron" ],
            "mappings": {
                "isMine": [ "memory", "cauldron" ]
            }
        }
    },
    "dataStores": {
        "signaling": { "type": "signaling" }
    }
}
